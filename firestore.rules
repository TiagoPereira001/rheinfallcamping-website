rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /vehicles/{vehicleId} {
      allow get, list: if true;
    }

    // Regra de negação explícita para dados pessoais, rate limits e futuras
    // coleções que ainda não tenham uma regra própria.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}