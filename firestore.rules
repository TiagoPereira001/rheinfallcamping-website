rules_version = '2';

// O cliente só pode consultar o catálogo público. Qualquer escrita e todos os
// leads passam pelas Cloud Functions, que usam o Admin SDK no servidor.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vehicles/{vehicleId} {
      allow get, list: if true;
    }

    // Regra de negação explícita para dados pessoais, rate limits e futuras
    // coleções que ainda não tenham uma regra própria.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
