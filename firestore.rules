rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // INCIDENT LOCKDOWN
    // Public catalogue reads remain available. All client writes and all
    // private-data reads are blocked until the Firebase project is verified.

    match /vehicles/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /leads/{doc} {
      allow read, write: if false;
    }

    match /securityRateLimits/{doc} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
